    {
      "type": "text",
      "id": "risk_table",
      "x": 60,
      "y": 770,
      "width": 660,
      "height": 100,
      "text": "Low risk (typo, config):   Self-review → Lint+types → Auto-merge OK\nMedium risk (feature):     1 adversarial review → Lint+types+tests → 1 code review\nHigh risk (security/infra): 2 adversarial reviews + human → Full suite → 2 reviews + human",
      "fontSize": 13,
      "fontFamily": 3,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },

