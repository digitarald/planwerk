{
  "name": "planwerk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.17.0",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "ahp:smoke": "node --experimental-strip-types scripts/ahp-smoke.ts",
    "start": "next start --hostname 127.0.0.1",
    "native:setup": "npm --prefix desktop ci && npm --prefix desktop run prepare",
    "native:build": "node scripts/build-desktop.mjs",
    "native:dev": "npm run native:build -- --dev && npm --prefix desktop run start",
    "native:test": "node --test scripts/*.test.mjs desktop/src/*.test.ts lib/desktop/*.test.ts lib/diagnostics/*.test.ts lib/data-directory.test.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs lib/**/*.test.ts lib/data-directory.test.ts desktop/src/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@github/copilot-sdk": "^1.0.22",
    "@hello-pangea/dnd": "^18.0.1",
    "@microsoft/agent-host-protocol": "1.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "vscode-jsonrpc": "8.2.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitarald/planwerk.git"
  },
  "homepage": "https://github.com/digitarald/planwerk#readme",
  "bugs": {
    "url": "https://github.com/digitarald/planwerk/issues"
  }
}
